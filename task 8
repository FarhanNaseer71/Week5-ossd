odometer = (1050, 1085, 1120, 1200, 1215)

# Pair adjacent elements using slicing inside a list comprehension
trip_segments = [
    (start, end, end - start)
    for start, end in zip(odometer[:-1], odometer[1:])
]

print(trip_segments)
# Output: [(1050, 1085, 35), (1085, 1120, 35), (1120, 1200, 80), (1200, 1215, 15)]
